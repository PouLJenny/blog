# 复制为 keys.env 再填(keys.env 不要提交到任何 git 仓库、不要出现在文章里)
#   cp keys.env.template keys.env

# ── Claude 官方(基线)──────────────────────────────
ANTHROPIC_KEY_OFFICIAL=
# 国内访问官方 API 需要代理时填,例如 http://127.0.0.1:7890;不需要则留空
CLAUDE_PROXY=

# ── GLM(智谱 bigmodel.cn)──────────────────────────
GLM_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# 想固定映射到某个 GLM 模型时填(如 glm-4.6);留空用智谱端点的默认映射
GLM_MODEL=

# ── DeepSeek(platform.deepseek.com)────────────────
DS_KEY=
DS_BASE_URL=https://api.deepseek.com/anthropic
DS_MODEL=
